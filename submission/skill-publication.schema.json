{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentel creator Skill manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "version",
    "description",
    "category",
    "license",
    "dataHandling",
    "instructions",
    "compatibility",
    "permissions",
    "knownLimits",
    "authorEvidence"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "dataHandling": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "sourceRevision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Public HTTPS; no credentials, query, or fragment. URL policy is additionally enforced by API."
    },
    "repositoryUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Public HTTPS; no credentials, query, or fragment. URL policy is additionally enforced by API."
    },
    "artifactUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Public HTTPS; no credentials, query, or fragment. URL policy is additionally enforced by API."
    },
    "compatibility": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "knownLimits": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "authorEvidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
